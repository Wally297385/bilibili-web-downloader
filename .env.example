# 服務基礎監聽設定
HOST=0.0.0.0
PORT=8087

# Web 登入認證 (請務必修改預設密碼)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 只在區網/VPN 使用時可設 false 取消登入
AUTH_ENABLED=true

# 資料與儲存路徑
STORAGE_BASE_DIR=./storage
LOGS_DIR=./data/logs
HISTORY_FILE=./data/history.json
COOKIE_FILE=./data/cookie.txt

# 加密金鑰
SECRET_KEY=bili-downloader-secret-key-change-me
